---
import faqData from "@/content/faq.json";
import {
  SITE_URL,
  SITE_PUBLISHED,
  SITE_MODIFIED,
  ORG_NAME,
  canonicalPath,
} from "@lib/site";

interface Props {
  includeFaq?: boolean;
  customFaq?: Array<{ q: string; a: string }>;
  path?: string;
  pageTitle?: string;
  /**
   * Emit the suite-level WebApplication entity. Set false on pages that carry no
   * tool interface (e.g. the alternatives comparison page), where declaring a
   * WebApplication would describe software the page does not actually provide.
   */
  includeWebApp?: boolean;
  /**
   * Freshness signals. Default to the site-wide dates in site.ts; a page may
   * override when its own content was published/updated on a different date.
   * ISO 8601 date form (YYYY-MM-DD).
   */
  datePublished?: string;
  dateModified?: string;
  /**
   * Emit a TechArticle entity carrying the freshness/authorship signals. Use on
   * editorial pages that have no tool interface (e.g. the alternatives
   * comparison), where the dated entity should be the article, not a
   * WebApplication. Requires `description`.
   */
  articlePage?: boolean;
  description?: string;
}
const {
  includeFaq = false,
  customFaq,
  path = "/",
  pageTitle,
  includeWebApp = true,
  datePublished = SITE_PUBLISHED,
  dateModified = SITE_MODIFIED,
  articlePage = false,
  description,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? SITE_URL;

// Stable @id for the Organization so other entities (author/publisher) can
// reference it instead of duplicating the object.
const orgId = new URL("/#organization", siteUrl).toString();

// Per-page Open Graph image as an ImageObject — structured-data support for the
// media generated by scripts/generate-og.mjs. Slug matches Meta.astro.
const ogSlug = (path || "/").replace(/^\/+|\/+$/g, "") || "home";
const ogImageObject = {
  "@type": "ImageObject",
  url: new URL(`/og/${ogSlug}.png`, siteUrl).toString(),
  width: 1200,
  height: 630,
};

const webApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "JSON Formatter Pro",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (browser-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  url: siteUrl,
  description:
    "Fast, private, client-side JSON formatter, validator, beautifier, minifier, and converter tools suite.",
  keywords: "JSON formatter, JSON beautifier, JSON validator, JSON minifier, JSON converter, JSON to YAML, JSON to XML, JSON to CSV, JSON to TypeScript, JWT decoder",
  browserRequirements: "Requires JavaScript and a modern browser.",
  isAccessibleForFree: true,
  inLanguage: "en",
  image: ogImageObject,
  datePublished,
  dateModified,
  author: { "@id": orgId },
  publisher: { "@id": orgId },
};

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId,
  name: ORG_NAME,
  alternateName: "JSON Formatter Pro",
  url: siteUrl,
  logo: new URL("/favicon.svg", siteUrl).toString(),
  description:
    "Fast, private, client-side JSON developer tools suite. 100% browser-based with zero server uploads.",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "Customer Support",
    email: "hashcode.dev@gmail.com",
  },
  sameAs: ["https://github.com/hashcode-dev/json-formatter-pro"],
};

const effectiveFaqData = customFaq || (includeFaq ? faqData : null);

const faq = effectiveFaqData
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: (effectiveFaqData as Array<{ q: string; a: string }>).map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    }
  : null;

const segments = path.replace(/^\/|\/$/g, "").split("/").filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
];
segments.forEach((seg, i) => {
  const segmentPath = canonicalPath("/" + segments.slice(0, i + 1).join("/"));
  const url = new URL(segmentPath, siteUrl).toString();
  const label = i === segments.length - 1 && pageTitle
    ? pageTitle
    : seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
  breadcrumbItems.push({
    "@type": "ListItem",
    position: i + 2,
    name: label,
    item: url,
  });
});
const breadcrumb = segments.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems,
    }
  : null;

// WebSite schema — rendered only on the homepage for sitelinks search box
const isHomepage = path === "/" || path === "";
const webSite = isHomepage
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "JSON Formatter Pro",
      url: siteUrl,
    }
  : null;

// TechArticle — freshness/authorship signal for editorial pages that carry no
// WebApplication (opt-in via `articlePage`). The dated entity here is the
// article itself rather than the software suite.
const pageUrl = new URL(canonicalPath(path), siteUrl).toString();
const article = articlePage
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: pageTitle,
      ...(description ? { description } : {}),
      mainEntityOfPage: pageUrl,
      url: pageUrl,
      inLanguage: "en",
      image: ogImageObject,
      datePublished,
      dateModified,
      author: { "@id": orgId },
      publisher: { "@id": orgId },
    }
  : null;
---

{includeWebApp && <script type="application/ld+json" set:html={JSON.stringify(webApp)} />}
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{article && <script type="application/ld+json" set:html={JSON.stringify(article)} />}
{faq && <script type="application/ld+json" set:html={JSON.stringify(faq)} />}
{breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
{webSite && <script type="application/ld+json" set:html={JSON.stringify(webSite)} />}
