---
import "@styles/global.css";
import Meta from "@components/seo/Meta.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import Header from "@components/site/Header.astro";
import Footer from "@components/site/Footer.astro";
import { CookieConsent } from "@components/site/CookieConsent";

interface Props {
  title: string;
  description: string;
  path?: string;
  includeFaq?: boolean;
  customFaq?: Array<{ q: string; a: string }>;
  keywords?: string;
  /** See StructuredData: false for pages with no tool interface. */
  includeWebApp?: boolean;
  /** See StructuredData: emit a dated TechArticle entity for editorial pages. */
  articlePage?: boolean;
}

const {
  title,
  description,
  path,
  includeFaq = false,
  customFaq,
  keywords,
  includeWebApp = true,
  articlePage = false,
} = Astro.props;

const GA_ID = "G-TKJSHMQD3E";
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline src="/scripts/sw-cleanup.js"></script>
    <script is:inline src="/scripts/consent-init.js"></script>
    <meta charset="UTF-8" />
    <Meta
      title={title}
      description={description}
      path={path}
      keywords={keywords}
    />
    <StructuredData
      includeFaq={includeFaq}
      customFaq={customFaq}
      path={path}
      pageTitle={title}
      includeWebApp={includeWebApp}
      articlePage={articlePage}
      description={description}
    />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
    ></script>
    <script is:inline src="/scripts/theme-init.js"></script>
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <a class="skip-link" href="#main">Skip to editor</a>
    <div class="flex min-h-screen flex-col">
      <Header />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <CookieConsent client:load />
  </body>
</html>
