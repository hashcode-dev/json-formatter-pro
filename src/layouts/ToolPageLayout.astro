---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FormatterApp } from "@components/formatter/FormatterApp";
import FaqAccordion from "@components/site/FaqAccordion.astro";
import ConversionDiagram from "@components/site/ConversionDiagram.astro";
import { CONVERSION_EXAMPLES } from "@/content/examples";
import { TOOL_INTROS } from "@/content/tool-intros";
import { CONVERSION_TABLES } from "@/content/conversion-tables";
import type { OutputMode } from "@store/index";

interface Props {
  title: string;
  description: string;
  keywords: string;
  path: string;
  eyebrow: string;
  heading: string;
  subtitle: string;
  mode: OutputMode;
  faqs: Array<{ q: string; a: string }>;
}

const {
  title,
  description,
  keywords,
  path,
  eyebrow,
  heading,
  subtitle,
  mode,
  faqs,
} = Astro.props;

// Per-tool worked-example diagram, matched on the page's bare slug (paths vary
// in trailing-slash form across pages, so normalize before the lookup).
const slug = path.replace(/^\/+|\/+$/g, "");
const example = CONVERSION_EXAMPLES[slug];
const intro = TOOL_INTROS[slug];
const table = CONVERSION_TABLES[slug];
---

<BaseLayout title={title} description={description} keywords={keywords} path={path} customFaq={faqs}>
  <section class="mx-auto max-w-[1400px] px-4 pt-6">
    <p class="text-xs font-medium uppercase tracking-wide text-subtle">{eyebrow}</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-fg sm:text-3xl">{heading}</h1>
    <p class="mt-1 max-w-2xl text-sm text-subtle">{subtitle}</p>
    <p class="mt-3">
      <span class="chip h-auto max-w-full py-1">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-3 w-3 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="11" width="16" height="9" rx="2"></rect>
          <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
        </svg>
        Nothing you paste leaves your browser
      </span>
    </p>
  </section>

  <section class="mx-auto mt-4 h-[calc(100vh-14rem)] min-h-[520px] max-w-[1400px] px-2 sm:px-4">
    <div class="card h-full overflow-hidden shadow-pop">
      <FormatterApp client:only="react" initialMode={mode} />
    </div>
  </section>

  <section class="mx-auto mt-12 max-w-[1400px] px-4 pb-16 space-y-8">
    <article class="card p-6 md:p-8 space-y-6 text-sm text-subtle leading-relaxed">
      {intro && (
        <section class="space-y-3">
          <h2 class="text-xl font-bold text-fg">{intro.heading}</h2>
          <p>{intro.body}</p>
        </section>
      )}
      {example && (
        <section class="space-y-3">
          <h2 class="text-xl font-bold text-fg">
            Worked example: {example.fromLabel} &rarr; {example.toLabel}
          </h2>
          <ConversionDiagram {...example} />
        </section>
      )}
      {table && (
        <section class="space-y-3">
          <h2 class="text-xl font-bold text-fg">{table.caption}</h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr>
                  <th scope="col" class="border-b border-border py-2 pr-4 font-semibold text-fg">{table.headers[0]}</th>
                  <th scope="col" class="border-b border-border py-2 font-semibold text-fg">{table.headers[1]}</th>
                </tr>
              </thead>
              <tbody>
                {table.rows.map((row) => (
                  <tr>
                    <td class="border-b border-border/60 py-2 pr-4 align-top font-mono text-xs text-fg">{row[0]}</td>
                    <td class="border-b border-border/60 py-2 align-top">{row[1]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}
      <slot />
    </article>

    <aside class="rounded-lg border border-border bg-surface px-4 py-3 text-sm text-subtle">
      Weighing this up against another tool? Our <a
        href="/json-formatter-alternatives/"
        class="text-accent hover:underline">honest comparison of JSON formatter alternatives</a
      > covers jsonformatter.org, jsoneditoronline.org, codebeautify.org and jam.dev &mdash; including
      the cases where one of them is the better pick.
    </aside>

    <FaqAccordion faqs={faqs} />
  </section>
</BaseLayout>
