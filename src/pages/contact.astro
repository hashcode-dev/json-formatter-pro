---
import BaseLayout from "@/layouts/BaseLayout.astro";

const contactFaqs = [
  {
    q: "What should I do if the formatter isn't working correctly?",
    a: `<p class="mt-4 text-sm text-subtle">
          First, try clearing your browser cache and localStorage. If the issue
          persists, please email us at hashcode.dev@gmail.com with:
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-6 text-sm text-subtle">
          <li>A description of the issue</li>
          <li>Steps to reproduce</li>
          <li>Your browser and OS (e.g., Chrome on macOS)</li>
          <li>A sample JSON file that triggers the issue (if applicable)</li>
        </ul>`,
  },
  {
    q: "How do I report a security issue?",
    a: `<p class="mt-4 text-sm text-subtle">
          Please do not disclose security vulnerabilities publicly. Instead,
          email hashcode.dev@gmail.com with details of the issue. We'll
          investigate and respond promptly.
        </p>`,
  },
  {
    q: "Can I request a new feature?",
    a: `<p class="mt-4 text-sm text-subtle">
          Absolutely! We welcome feature requests. You can:
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-6 text-sm text-subtle">
          <li>Open a GitHub issue with the label "feature-request"</li>
          <li>Email us at hashcode.dev@gmail.com</li>
        </ul>`,
  },
  {
    q: "Do you offer enterprise or custom solutions?",
    a: `<p class="mt-4 text-sm text-subtle">
          For enterprise inquiries, licensing questions, or custom development,
          please contact us at hashcode.dev@gmail.com.
        </p>`,
  },
  {
    q: "How do I report abuse or policy violations?",
    a: `<p class="mt-4 text-sm text-subtle">
          If you believe someone is using JSON Formatter Pro in violation of our
          Terms of Service or for illegal purposes, please report it to
          hashcode.dev@gmail.com with details.
        </p>`,
  },
];
---

<BaseLayout
  title="Contact Us - JSON Formatter Pro"
  description="Get in touch with the JSON Formatter Pro team. Send us your questions, feedback, or support requests."
  path="/contact"
  keywords="contact, support, feedback, help, customer service"
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold text-fg">Contact Us</h1>
    <p class="mt-3 text-subtle">
      Have a question or feedback? We'd love to hear from you. Get in touch
      using any of the methods below.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-border bg-surface p-6">
        <h2 class="text-lg font-semibold text-fg">📧 Email</h2>
        <p class="mt-2 text-sm text-subtle">
          For general inquiries and support requests:
        </p>
        <a
          href="mailto:hashcode.dev@gmail.com"
          class="mt-3 inline-flex items-center gap-2 text-accent hover:underline"
        >
          hashcode.dev@gmail.com →
        </a>
      </div>

      <div class="rounded-lg border border-border bg-surface p-6">
        <h2 class="text-lg font-semibold text-fg">💬 GitHub</h2>
        <p class="mt-2 text-sm text-subtle">Report bugs or discuss features:</p>
        <a
          href="https://github.com/hashcode-dev/json-formatter-pro/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 text-accent hover:underline"
        >
          Open an issue →
        </a>
      </div>

      <div class="rounded-lg border border-border bg-surface p-6">
        <h2 class="text-lg font-semibold text-fg">⏱️ Response Time</h2>
        <p class="mt-2 text-sm text-subtle">
          We typically respond to inquiries within 48 hours during business
          days.
        </p>
      </div>

      <div class="rounded-lg border border-border bg-surface p-6">
        <h2 class="text-lg font-semibold text-fg">🏢 Address</h2>
        <p class="mt-2 text-sm text-subtle">
          Hashcode Technologies & Software Solutions<br />
          62/46A/5C<br />
          Nawab Yusuf Road<br />
          Prayagraj<br />
          U.P. 211001
        </p>
      </div>
    </div>

    <div class="mt-12 rounded-lg border border-border bg-surface p-8">
      <h2 class="text-lg font-semibold text-fg">
        Frequently Asked Contact Questions
      </h2>

      {contactFaqs.map((item, i) => (
        <details class:list={["group border-t border-border pt-6", i === 0 && "mt-6"]} open={i === 0}>
          <summary
            class="flex cursor-pointer items-center justify-between gap-4 text-base font-medium text-fg"
          >
            <span>{item.q}</span>
            <span class="text-subtle transition-transform group-open:rotate-45">+</span>
          </summary>
          <Fragment set:html={item.a} />
        </details>
      ))}
    </div>
  </article>
</BaseLayout>
